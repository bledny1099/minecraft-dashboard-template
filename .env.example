# ==========================================
# Minecraft Dashboard & Live Console Configuration
# ==========================================

# Initial Administrator Credentials (created automatically on first launch)
DASH_USER=admin
DASH_PASS=ChangeMe_SecurePassword2026

# Host and port to listen on (0.0.0.0:8095 listens on all interfaces)
DASH_BIND=0.0.0.0:8095

# Path to your Minecraft server root directory (where logs/ and world/ reside)
MC_SERVER_DIR=/home/minecraft/server

# Minecraft RCON Settings (must match server.properties)
# In server.properties set:
#   enable-rcon=true
#   rcon.port=25575
#   rcon.password=your_secret_rcon_pass
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASS=your_secret_rcon_pass

# Public Server Connection Info (shown in "How to Connect" modal)
SERVER_PUBLIC_HOST=mc.yourdomain.com
SERVER_PUBLIC_PORT=25565
