# Caddyfile configuration example for automatic HTTPS + SSE streaming
mc.yourdomain.com {
    # Reverse proxy to dashboard with flush_interval -1 for real-time SSE streaming
    reverse_proxy 127.0.0.1:8095 {
        flush_interval -1
    }

    # Security headers (handled by aiohttp, Caddy ensures TLS 1.3)
    encode zstd gzip
}
